  "starts": {
    "1": "Kömək qapısını aç, ey yaradan!",
    "2": "Bu qara toıpağa sükunət verən,",
    "3": "Göyün səyyahları, bilirsən neçin",
    "4": "Xudaya! Gilimiz mayələnincən",
    "5": "Böyük Məhəmmədə yüz min afərin!",
    "6": "Tale dövlət quşu uçuran zaman",
    "7": "Dünya padişahı bəxtiyar xaqan",
    "8": "Güldü iqbalıma taleyin üzü,",
    "9": "Allah Köməyilə tapşırılan taxt",
    "10": "Tez ol, ey səhərin gözəl nəsimi!",
    "11": "Ürəyin hatifı görüb məni şad.",
    "12": "Eşqdən başqa söz Könlümə yaddır,",
    "13": "Qapayan zamanda qapılan mən",
    "14": "Köhnə dastanların qoca ustadı",
    "15": "Günlərin bir günü, bir səhər erkən",
    "16": "Başına gələn bu qəzanı görcək",
    "17": "Gecənin saçları ətir saçanda,",
    "18": "Şapur adlı ona yaxın bir adam",
    "19": "O söz bilən Şapur yeri opərək,",
    "20": "Elə Kİ, gecənin saçı darandı,",
    "21": "Gül rəngli at səhər zərrin nalından",
    "22": "Gecənin qoynundan çıxınca səhər",
    "23": "Əfsunçu xəlvətdən çıxdı qəflətən,",
    "24": "Elə Kİ, bir səhər Çin xəznədarı",
    "25": "Qoca söz ustadı, həmin parsixan",
    "26": "Düzəltmək istəsə bir işi fələk,",
    "27": "Mədaində Şirin gözləyir vüsal.",
    "28": "Xosrov görəndə Kİ, dalda qaldı su,",
    "29": "Bir gecə, novruzdan daha şən gecə.",
    "30": "Həyat aləmidir hər şeydən üstün,",
    "31": "Oturmuşdu bir gün şah yarı xumar,",
    "32": "Elə Kİ, allahın əmriylə bir gün",
    "33": "Şirini götürüb qayıtdı Şapur,",
    "34": "Zəfərin açarı aydın, aş Kardır,",
    "35": "Dünya görmüş Kişi başladı sözə:",
    "36": "Cütçü saf tum səpsə torpağa əgər,",
    "37": "Asimantək, yaşıl geymiş o qoca",
    "38": "Gəzməyə çıxmışdı şah bir gün erkən",
    "39": "Gündüzdən işıqlı, aydın bir gecə...",
    "40": "Birinci Firəngiz dedi: \"Bir zaman",
    "41": "Bir gözəl gecəydi, Иk bahar idi.",
    "42": "Ürəyi Şirindən incik gedirdi.",
    "43": "Keyf etdkdən sonra şah bir neçə gün,",
    "44": "Ay yüksələn zaman Balıq bürcündən",
    "45": "Söz ustadlığında o zəhmət çəkən",
    "46": "Təsəlli verirdi Şirinə Banu,",
    "47": "Şirinin əlinə çatanda şahlıq",
    "48": "Sübhün şahənşahı təxtinə çıxdı.",
    "49": "Dördüncü gün yenə məclis düzəldi.",
    "50": "Sərxoş bülbül Kimi gələndə Barbəd",
    "51": "Göyün yaxasından çıxanda qəmər",
    "52": "Şah bir gün Şapura dedi: \"Söylə, mən",
    "53": "O pəri cilvəli, zərli, ipəkii,",
    "54": "Fərhad Kİ, Şirinə hrək bağladı.",
    "55": "Sarayın əhlindən, mərhəm bir nəfər",
