  "translator": "Məmməd Rahim",
  "year": 1941,
  "translatorNote": "Məmməd Rahimin tərcüməsi (1941), Nizami Gəncəvi, «Xəmsə», Gəncə, 2011 nəşrinə görə; mətn skandan əl ilə köçürülüb.",
  "workSlugBase": "nizami-yeddi-gozel",
  "noteHeight": 0,
  "dropCaps": true,
  "first": "Ey bu kainatın açan gözünü,",
  "last": "İşlər səadətlə yetişsin sona!",
  "runningHeads": "^$",
  "starts": {
    "1": "Ey bu kainatın açan gözünü,",
    "2": "İlk pərgar xəttinin mərkəz nöqtəsi,",
    "3": "Onun sığışmadı cahana tacı,",
    "4": "Şahlıq dərgahından gizli işarə",
    "5": "Ey könül, bu xəyal yaratmaqla sən",
    "6": "Sözdür həm təzə şey, həm də köhnə şey,",
    "7": "Kim ki, ibrət dərsi alıb dünyadan",
    "8": "Sirlər xəznədarı xəznəni açdı,",
    "9": "Dolanıb ətrafı hey qarış-qarış,",
    "10": "Bəhramın hünəri saçınca şəfəq",
    "11": "Onda ki, Bəhramın üzü nur saldı,",
    "12": "Şah bir gün bağçanın gözəl yerində",
    "13": "Səfərdən qayıdıb bir yol bizim şah,",
    "14": "Bir gün Yəzdigirdi eyləyib agah,",
    "15": "Ey söz düyümləyən cadugər, yetər,",
    "16": "Məktubun başlanğıc sözü bismillah,",
    "17": "Məktubu oxuyan eylədi tamam,",
    "18": "Səhər qızıl taclı, sabah xeyli şən,",
    "19": "Bəhram sevdiyindən xeyirxahlığı",
    "20": "Bəhram şah bir səhər çıxdı şikara,",
    "21": "Taxtından enərək bir gözəl sabah",
    "22": "Bəhramın şöhrəti düşdü dünyaya,",
    "23": "Günlərin birində mübarək baxtı",
    "24": "Əyləndi, başladı keyfə asudə,",
    "25": "Bir gün zəfər çaldı sübhün nur çağı,",
    "26": "Elə ki, büsatla coşdu, çağladı,",
    "27": "Dan yeri ağarıb şəfəq sökəndə,",
    "28": "Elə ki, düşənbə gəldi ortaya,",
    "29": "Dey ayında günlər gödəkdir, gödək,",
    "30": "Çərşənbə günündə qönçə açdı gün",
    "31": "Pəncşənbə - günlərdə yaxşı bir gündür,",
    "32": "Cümə günü səhər bu yamyaşıl tağ",
    "33": "Müştəriylə Zühəl qovuşan zaman",
    "34": "Arabir də gedib ova oldu şad,",
    "35": "Söylədi Bəhrama birinci adam:",
    "36": "Tozlu kilimini yer qalxıb aldı,",
    "37": "Dürlər peyvənd edən ləlin bağına,",
    "38": "Tam əks-əyarlı nəqdi Gəncədən"
  },
  "corrections": [
    {
      "from": "cəbrayıl",
      "to": "Cəbrayıl"
    }
  ]
}
