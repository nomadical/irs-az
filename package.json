{
  "name": "irs-az",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @irs-az/api dev",
    "dev:web": "pnpm --filter @irs-az/web dev",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f",
    "dev": "pnpm --filter @irs-az/api dev & pnpm --filter @irs-az/web dev",
    "build:api": "pnpm --filter @irs-az/api build",
    "build:web": "pnpm --filter @irs-az/web build",
    "build": "pnpm --filter @irs-az/api build & pnpm --filter @irs-az/web build",
    "db:generate": "pnpm --filter @irs-az/api prisma:generate",
    "db:migrate": "pnpm --filter @irs-az/api prisma:migrate",
    "db:seed": "pnpm --filter @irs-az/api prisma:seed",
    "parse": "pnpm --filter parser parse",
    "parse:authors": "pnpm --filter parser scrape:authors",
    "parse:works": "pnpm --filter parser scrape:works",
    "parse:import": "pnpm --filter parser import",
    "parse:audit": "pnpm --filter parser audit",
    "lint": "pnpm run -r lint"
  },
  "engines": {
    "node": ">=20"
  }
}
