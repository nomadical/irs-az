# Public API URL, inlined into browser code at build time (production: "/api")
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
# Internal API URL for server-side rendering, read at runtime (defaults to NEXT_PUBLIC_API_URL)
API_URL="http://localhost:4000/api"
# Public origin for canonical URLs, sitemap and share images, read at runtime
SITE_URL="http://localhost:3000"
# Shown on /contact, read at runtime (optional)
CONTACT_EMAIL=""
