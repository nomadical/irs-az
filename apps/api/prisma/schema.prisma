generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ─────────────────────────────────────

enum Language {
  AZ_LATIN
  AZ_ARABIC
  AZ_CYRILLIC
  FA
  AR
  RU
  EN
  TR
}

enum ScriptDirection {
  LTR
  RTL
}

enum Genre {
  POEM
  PROSE
  PLAY
  ESSAY
  PHILOSOPHY
  LETTER
  MEMOIR
}

enum PoemForm {
  GHAZAL
  MASNAVI
  RUBAI
  QASIDA
  MURABBA
  FREE_VERSE
  OTHER
}

enum AuthorType {
  POET
  WRITER
  PHILOSOPHER
  PLAYWRIGHT
  CRITIC
}

enum TranslationType {
  TRANSLATION
  TRANSLITERATION
  MODERNIZATION
}

enum UserRole {
  SUPERADMIN
  EDITOR
  CONTRIBUTOR
  READER
}

enum SubmissionType {
  AUTHOR
  WORK
  TRANSLATION
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ── USER ──────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  name         String?
  passwordHash String?
  role         UserRole @default(READER)
  avatarUrl    String?
  bio          String?
  isVerified   Boolean  @default(false)
  isBanned     Boolean  @default(false)

  submissions Submission[]
  blogPosts   BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── AUTHOR ────────────────────────────────────

model Author {
  id   String @id @default(cuid())
  slug String @unique

  nameAz String
  nameRu String?
  nameFa String?
  nameEn String?

  bornYear       Int?
  bornYearApprox Boolean @default(false)
  diedYear       Int?
  diedYearApprox Boolean @default(false)
  bornPlace      String?
  diedPlace      String?

  type        AuthorType @default(POET)
  period      String?
  writingLangs Language[]

  bioAz String? @db.Text
  bioRu String? @db.Text
  bioEn String? @db.Text

  portraitUrl    String?
  portraitSource String?

  status     PublishStatus @default(DRAFT)
  featuredAt DateTime?

  collections Collection[]
  works       Work[]
  tags        AuthorTag[]
  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([nameAz])
  @@index([period])
  @@index([type])
}

// ── COLLECTION ────────────────────────────────

model Collection {
  id   String @id @default(cuid())
  slug String @unique

  titleAz String
  titleRu String?
  titleFa String?
  titleEn String?

  authorId String
  author   Author @relation(fields: [authorId], references: [id])

  year         Int?
  yearApprox   Boolean  @default(false)
  originalLang Language @default(AZ_LATIN)
  genre        Genre    @default(POEM)

  descriptionAz String? @db.Text
  descriptionRu String? @db.Text

  order  Int?
  status PublishStatus @default(DRAFT)

  works Work[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([slug])
}

// ── WORK ──────────────────────────────────────

model Work {
  id   String @id @default(cuid())
  slug String @unique

  titleAz String
  titleRu String?
  titleFa String?
  titleEn String?

  body     String @db.Text
  bodyHtml String? @db.Text

  originalLang    Language
  scriptDirection ScriptDirection @default(LTR)

  genre Genre @default(POEM)
  form  PoemForm?

  year       Int?
  yearApprox Boolean @default(false)

  order Int?

  authorId String
  author   Author @relation(fields: [authorId], references: [id])

  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id])

  sourceNote String?

  status    PublishStatus @default(DRAFT)
  viewCount Int           @default(0)

  translations Translation[]
  tags         WorkTag[]
  submissions  Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([collectionId, order])
  @@index([slug])
  @@index([originalLang])
  @@index([year])
}

// ── TRANSLATION ───────────────────────────────

model Translation {
  id String @id @default(cuid())

  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  language        Language
  type            TranslationType @default(TRANSLATION)
  scriptDirection ScriptDirection @default(LTR)

  body     String  @db.Text
  bodyHtml String? @db.Text

  translator     String?
  translatorNote String?
  year           Int?
  sourceNote     String?

  isDefault Boolean @default(false)

  status PublishStatus @default(DRAFT)

  submissionId String?     @unique
  submission   Submission? @relation(fields: [submissionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workId, language, type])
  @@index([workId])
  @@index([language])
}

// ── TAGS ──────────────────────────────────────

model Tag {
  id     String @id @default(cuid())
  slug   String @unique
  nameAz String
  nameRu String?
  nameEn String?

  authors AuthorTag[]
  works   WorkTag[]
}

model AuthorTag {
  authorId String
  tagId    String
  author   Author @relation(fields: [authorId], references: [id])
  tag      Tag    @relation(fields: [tagId], references: [id])

  @@id([authorId, tagId])
}

model WorkTag {
  workId String
  tagId  String
  work   Work   @relation(fields: [workId], references: [id])
  tag    Tag    @relation(fields: [tagId], references: [id])

  @@id([workId, tagId])
}

// ── SUBMISSIONS ───────────────────────────────

model Submission {
  id String @id @default(cuid())

  type   SubmissionType
  status SubmissionStatus @default(PENDING)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  payload Json

  sourceNote String?

  authorId    String?
  author      Author?      @relation(fields: [authorId], references: [id])
  workId      String?
  work        Work?        @relation(fields: [workId], references: [id])
  translation Translation?

  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@index([type])
}

// ── BLOG ──────────────────────────────────────

model BlogPost {
  id   String @id @default(cuid())
  slug String @unique

  titleAz String
  titleRu String?
  titleEn String?

  bodyAz String  @db.Text
  bodyRu String? @db.Text
  bodyEn String? @db.Text

  excerpt  String?
  coverUrl String?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  relatedAuthorId String?

  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  viewCount   Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([publishedAt])
}
