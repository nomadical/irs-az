# Copy to /opt/irs-az/.env on the server and fill in. Generate secrets with: openssl rand -hex 32
DOMAIN=irs.az
TLS="/etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem"
IMAGE_TAG=latest

POSTGRES_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
MEILISEARCH_KEY=

# Cloudflare R2: uploads bucket + nightly database backups
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=irs-az
BACKUP_BUCKET=irs-az-backups
